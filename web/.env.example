# Firebase web SDK config. These values are public by design — they ship in the
# JS bundle. Real values live in web/.env.local (gitignored) so this public repo
# doesn't advertise the project's API key to quota scrapers.
#
# Regenerate with:
#   firebase apps:sdkconfig WEB --project ig-study

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Run base URL for the FastAPI service (step 1). Video must hit Cloud Run
# directly — a Firebase Hosting rewrite caps at 60 s and breaks streaming.
VITE_API_BASE_URL=
