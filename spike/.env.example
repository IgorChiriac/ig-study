# Copy to .env and fill in. .env is gitignored — never commit it.

# Google Cloud Console → Google Auth Platform → Clients → Create client.
#
# Either client type works. "Desktop app" accepts a loopback redirect on any
# port with nothing to register. "Web application" requires the exact callback
# URI below to be registered as an authorized redirect URI, port included:
#
#     http://localhost:8765/callback
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if 8765 is taken. On a Web client, changing this means registering the
# new URI too — the port has to match exactly.
# OAUTH_CALLBACK_PORT=8765

# Printed by: python get_refresh_token.py
# Does not expire. Treat it like a password.
DRIVE_REFRESH_TOKEN=

# The Drive file ID of one real course video to test with.
# Get it from the share URL: drive.google.com/file/d/<THIS_PART>/view
DRIVE_FILE_ID=
