# Copy to .env and fill in. .env is gitignored — never commit it.

# From Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID, application type "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed by: python get_refresh_token.py
# Does not expire. Treat it like a password.
DRIVE_REFRESH_TOKEN=

# The Drive file ID of one real course video to test with.
# Get it from the share URL: drive.google.com/file/d/<THIS_PART>/view
DRIVE_FILE_ID=
