# Copy to .env for local dev. .env is gitignored — never commit it.
# In production these come from Secret Manager, injected by Cloud Run.

# Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID, application type "Desktop app".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed once by: python spike/get_refresh_token.py
# Does not expire. Treat it like a password.
DRIVE_REFRESH_TOKEN=

# Signs the short-lived token in the ?t= of the video URL. This is the third
# secret, and it is NOT the Firebase signing key or the Drive credential.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
STREAM_JWT_SECRET=

# Optional overrides.
# STREAM_TOKEN_TTL_S=3600
# FIREBASE_PROJECT_ID=ig-study
# ALLOWED_ORIGINS=https://ig-study.web.app,https://ig-study.firebaseapp.com,http://localhost:5173
